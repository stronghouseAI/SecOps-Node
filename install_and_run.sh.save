#!/bin/bash

echo "/// SECOPS NODE INSTALLER ///"

# 1. Check for Python
if ! command -v python3 &> /dev/null; then
    echo "[!] Python3 could not be found. Please install it."
    exit
fi

# 2. Check for Ollama
if ! command -v ollama &> /dev/null; then
    echo "[!] Ollama is not installed. Installing..."
    curl -fsSL https://ollama.com/install.sh | sh
fi

# 3. Pull Models (Heavy Download)
echo "[*] Downloading Neural Models (Blue/Red Team)..."
ollama pull llama3
ollama pull whiterabbitneo

# 4. Create Virtual Env
echo "[*] Creating Sandbox Environment..."
python3 -m venv ai_env
source ai_env/bin/activate

# 5. Install Dependencies
echo "[*] Installing Libraries..."
# Note: Ensure requirements.txt is in the same folder
pip install streamlit ollama chromadb sentence-transformers langchain langchain-community huggingface_hub pandas requests datasets

# 6. Run
echo "[*] LAUNCHING CONSOLE..."
streamlit run sec_ops.p
